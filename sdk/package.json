{
  "name": "dltool-sdk",
  "version": "0.1.1",
  "description": "Browser SDK that sends small files to the browser and large files to the local download tool.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "unpkg": "./dist/dltool-sdk.iife.js",
  "jsdelivr": "./dist/dltool-sdk.iife.js",
  "browser": "./dist/dltool-sdk.iife.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test test/download-tool.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "license": "UNLICENSED"
}
